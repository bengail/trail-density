---
import Base from "../layouts/Base.astro";
import { loadIndex, loadRace, formatRank } from "../lib/data";
import { t, racePath, countryName, flag, fmtNum, fmtDelta, SERIES, type Lang } from "../lib/i18n";
import { historyChart } from "../lib/charts";
import { editionView } from "../lib/edition-view";
import type { Gender } from "../lib/types";

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const s = t(lang);
const race = loadRace(id);
const summary = loadIndex().races.find(r => r.id === id)!;
const latest = race.editions[0];

// Headline numbers: latest RCI10 per gender, change since the previous edition, rank within the format.
function kpi(g: Gender) {
  const eds = race.editions.filter(e => e[g]?.rci10 != null);
  if (!eds.length) return null;
  const [cur, prev] = eds;
  return {
    year: cur.year,
    value: cur[g]!.rci10!,
    delta: prev ? { d: cur[g]!.rci10! - prev[g]!.rci10!, year: prev.year } : null,
    rank: formatRank(summary, g),
  };
}
const kpis = { F: kpi("F"), M: kpi("M") };

const km = race.distance_km ?? latest.distance_km;
const dplus = race.elevation_gain ?? latest.elevation_gain;
const meta = [
  `${flag(race.country)} ${countryName(lang, race.country)}`,
  race.format ? s.format_label[race.format] : null,
  km ? `${fmtNum(lang, km, km % 1 ? 1 : 0)} km` : null,
  dplus ? `${fmtNum(lang, dplus)} m D+` : null,
].filter(Boolean);
const title = `${race.name} — RCI · Trail Density`;
const desc = lang === "fr"
  ? `Niveau du plateau de ${race.name} : RCI10 ${kpis.F ? `femmes ${Math.round(kpis.F.value)}` : ""}${kpis.F && kpis.M ? ", " : ""}${kpis.M ? `hommes ${Math.round(kpis.M.value)}` : ""} (${latest.year}), évolution depuis ${race.editions.at(-1)!.year}.`
  : `Field strength at ${race.name}: RCI10 ${kpis.F ? `women ${Math.round(kpis.F.value)}` : ""}${kpis.F && kpis.M ? ", " : ""}${kpis.M ? `men ${Math.round(kpis.M.value)}` : ""} (${latest.year}), history since ${race.editions.at(-1)!.year}.`;
const years = race.editions.map(e => e.year);
---
<Base lang={lang} title={title} description={desc} alternate={{ fr: racePath("fr", id), en: racePath("en", id) }}>
  <div class="wrap page">
    <section class="hero">
      <p class="eyebrow"><a class="back" href={`/${lang}/`}>← {s.all_races}</a>{race.event.name !== race.name && <span> · {race.event.name}</span>}</p>
      <h1>{race.name}</h1>
      <p class="meta muted">{meta.join("  ·  ")}</p>
      {race.series.length > 0 && <p class="series">{race.series.map(x => <span class="chip">{SERIES[x] ?? x}</span>)}</p>}

      <div class="kpis">
        {(["F", "M"] as const).map(g => {
          const k = kpis[g];
          return (
            <div class={`kpi ${g.toLowerCase()}`}>
              <p class="kpi-label">{g === "F" ? s.women : s.men}{k && <span class="muted"> · RCI10 {k.year}</span>}</p>
              {k ? (
                <>
                  <p class="kpi-value num">{fmtNum(lang, k.value, 1)}</p>
                  <p class="kpi-ctx">
                    {k.delta && <span class={`delta ${k.delta.d >= 0 ? "up" : "down"} num`}>{s.vs_last(fmtDelta(lang, k.delta.d), k.delta.year)}</span>}
                    {k.rank && race.format && <span class="muted">{s.rank_in_format(k.rank.rank, k.rank.of, s.formats[race.format])}</span>}
                  </p>
                </>
              ) : <p class="muted">{s.not_enough}</p>}
            </div>
          );
        })}
      </div>
      <p class="help muted">{s.rci_help} <a href={`/${lang}/`}>{s.learn_more}</a></p>
    </section>

    {race.editions.length > 1 && (
      <section class="card">
        <div class="card-head">
          <div>
            <h2>{s.history}</h2>
            <p class="sub muted">{s.history_sub}</p>
          </div>
          <div class="legend"><span class="f">{s.women}</span><span class="m">{s.men}</span></div>
        </div>
        <Fragment set:html={historyChart(race.editions, { M: s.men, F: s.women })} />
      </section>
    )}

    <section class="edition" data-race={id} data-lang={lang}>
      <div class="ed-head">
        <h2>{s.edition} <span class="num" data-year>{latest.year}</span></h2>
        <div class="years" role="tablist">
          {years.map((y, i) => <button type="button" class="year num" role="tab" aria-selected={i === 0 ? "true" : "false"} data-y={y}>{y}</button>)}
        </div>
      </div>
      <div data-edition>
        <Fragment set:html={editionView(lang, latest)} />
      </div>
    </section>

    <p class="actions"><a class="btn" href={`/${lang}/`}>{s.compare_with}</a></p>
  </div>
</Base>

<script>
  import { editionView } from "../lib/edition-view";
  import type { Race } from "../lib/types";
  import type { Lang } from "../lib/i18n";

  // Switch the edition block without reloading: the race JSON is fetched once, on first use.
  const root = document.querySelector<HTMLElement>(".edition");
  if (root) {
    const lang = root.dataset.lang as Lang;
    let race: Race | null = null;
    root.querySelectorAll<HTMLButtonElement>("button.year").forEach(btn => {
      btn.addEventListener("click", async () => {
        race ??= await fetch(`/data/races/${root.dataset.race}.json`).then(r => r.json());
        const ed = race!.editions.find(e => e.year === Number(btn.dataset.y));
        if (!ed) return;
        root.querySelector("[data-edition]")!.innerHTML = editionView(lang, ed);
        root.querySelector("[data-year]")!.textContent = String(ed.year);
        root.querySelectorAll("button.year").forEach(b => b.setAttribute("aria-selected", String(b === btn)));
      });
    });
  }
</script>

<style is:global>
  .page { display: grid; gap: 20px; padding-top: 28px; }
  .page > *, .edition > *, [data-edition] > *, .ed-grid > * { min-width: 0; }   /* the year strip must scroll, not widen the grid */
  .hero .back { text-decoration: none; }
  .hero .back:hover { color: var(--text); }
  .hero h1 { font-size: clamp(30px, 6vw, 46px); font-weight: 800; letter-spacing: -0.02em; margin: 8px 0 6px; }
  .hero .meta { margin: 0; font-size: 14px; }
  .hero .series { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }

  .kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 22px; }
  @media (max-width: 520px) { .kpis { grid-template-columns: 1fr; } }
  .kpi { border-radius: var(--radius); padding: 16px 18px; border: 1px solid var(--border); background: var(--surface); }
  .kpi.f { border-top: 4px solid var(--women); }
  .kpi.m { border-top: 4px solid var(--men); }
  .kpi p { margin: 0; }
  .kpi-label { font-size: 13px; font-weight: 700; }
  .kpi.f .kpi-label { color: var(--women); }
  .kpi.m .kpi-label { color: var(--men); }
  .kpi-value { font-size: clamp(40px, 8vw, 56px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; margin: 6px 0 8px !important; }
  .kpi-ctx { display: flex; flex-direction: column; gap: 2px; font-size: 13px; }
  .delta.up { color: var(--women); }
  .kpi.m .delta.up { color: var(--men); }
  .delta.down { color: var(--text-2); }
  .help { font-size: 13px; margin: 14px 0 0; max-width: 680px; }

  .card h2 { font-size: 19px; font-weight: 800; }
  .card h3 { font-size: 16px; font-weight: 800; }
  .card h4 { font-size: 13px; font-weight: 700; margin: 0 0 8px; }
  .sub { font-size: 13px; margin: 4px 0 10px; }
  .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }

  .edition { display: grid; gap: 16px; }
  .ed-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 12px; }
  .ed-head h2 { font-size: 22px; font-weight: 800; }
  .years { display: flex; gap: 6px; overflow-x: auto; max-width: 100%; padding-bottom: 4px; scrollbar-width: thin; }
  .year {
    font-size: 12.5px; font-weight: 500; padding: 5px 10px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--border); background: var(--surface); color: var(--text-2);
  }
  .year[aria-selected="true"] { background: var(--text); color: var(--bg); border-color: var(--text); }

  [data-edition] { display: grid; gap: 16px; }
  .ed-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 900px) { .ed-grid { grid-template-columns: 1fr 1fr; } }
  .legend { margin-bottom: 6px; }
  .legend.mirror { justify-content: space-between; padding: 0 22%; }

  .depth-grid, .top-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 12px; }
  @media (min-width: 720px) { .depth-grid, .top-grid { grid-template-columns: 1fr 1fr; } }
  .depth.f h4, .top.f h4 { color: var(--women); }
  .depth.m h4, .top.m h4 { color: var(--men); }
  .depth dl { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .depth dl div { background: var(--surface-2); border-radius: 8px; padding: 8px 10px; }
  .depth dt { font-size: 11.5px; color: var(--text-2); }
  .depth dd { margin: 2px 0 0; font-size: 18px; font-weight: 600; }

  .top table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .top th { text-align: left; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-2); padding: 0 6px 6px; }
  .top td { padding: 6px; border-top: 1px solid var(--divider); }
  .top td.num, .top th:not(:nth-child(2)) { text-align: right; }
  .top td:first-child, .top th:first-child { text-align: left; width: 2.2em; color: var(--text-2); }
  .top .who { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0; width: 100%; }
  .top .flag { margin-right: 6px; }
  .top .idx { font-weight: 600; }
  .top.f .idx { color: var(--women); }
  .top.m .idx { color: var(--men); }
  .source { font-size: 12px; margin: 12px 0 0; }

  .actions { margin: 4px 0 0; }
  .btn {
    display: inline-block; padding: 9px 16px; border-radius: 8px; font-weight: 700; font-size: 14px;
    background: var(--men); color: white; text-decoration: none;
  }
</style>
