# Import scripts (scripts/import.mjs) write to Supabase over a direct Postgres connection.
# Supabase dashboard → Connect → "Session pooler" connection string (IPv4-friendly).
DATABASE_URL=postgresql://postgres.iuwbagagydrknhgvvexv:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: lets the import scripts renew expired ITRA / UTMB sessions on their own.
# Without them, run `pnpm run login` when a session expires. Use passwords unique to these sites.
ITRA_EMAIL=
ITRA_PASSWORD=
UTMB_EMAIL=
UTMB_PASSWORD=
